// Workgroup reduction of accumulator into total, both flavors; SwiGLU's epilogue runs it twice with uniform barriers.
#ifdef USE_SUBGROUP
#define Q4_REDUCE(total) { (total) = subgroupAdd(accumulator); }
#else
#define Q4_REDUCE(total) { \
  reduce_scratch[lane] = accumulator; \
  barrier(); \
  for (uint offset = 1u; offset < LANES; offset <<= 1u) { \
    if ((lane_in_slot & (2u * offset - 1u)) == 0u) { \
      reduce_scratch[lane] += reduce_scratch[lane + offset]; \
    } \
    barrier(); \
  } \
  (total) = reduce_scratch[lane]; \
}
