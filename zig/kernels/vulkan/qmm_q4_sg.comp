// Greedy-argmax head: one stage per dispatch prunes rows that cannot hold the argmax; survivors take the exact GEMV.
const uint GREEDY_ROWS_PER_SLOT = 16u;
const uint STATE_LB = 64u;
const uint STATE_UB = 65u;
const uint STATE_COUNT = 66u;
const uint STATE_FULL = 67u;
#define NEG_INF uintBitsToFloat(0xff800000u)

shared float greedy_values[256];
shared uint greedy_rows[256];
shared uint greedy_flag;

// Monotone float -> uint map for atomicMax; key 0 decodes to NaN.
uint order_key(float f) {
  uint bits = floatBitsToUint(f);
  return (bits & 0x80000000u) != 0u ? ~bits : (bits | 0x80000000u);
}
float order_value(uint key) {
  return uintBitsToFloat(
      (key & 0x80000000u) != 0u ? (key & 0x7fffffffu) : ~key);
}

#define GREEDY_X8(i) { \
  uvec4 xw = input_x.values[xbase + (i)]; \
  xr[8u * (i)] = uintBitsToFloat((xw.x & 0xFFFFu) << 16u); \
  xr[8u * (i) + 1u] = uintBitsToFloat(xw.x & 0xFFFF0000u); \
  xr[8u * (i) + 2u] = uintBitsToFloat((xw.y & 0xFFFFu) << 16u); \
  xr[8u * (i) + 3u] = uintBitsToFloat(xw.y & 0xFFFF0000u); \
  xr[8u * (i) + 4u] = uintBitsToFloat((xw.z & 0xFFFFu) << 16u); \
  xr[8u * (i) + 5u] = uintBitsToFloat(xw.z & 0xFFFF0000u); \
  xr[8u * (i) + 6u] = uintBitsToFloat((xw.w & 0xFFFFu) << 16u); \
  xr[8u * (i) + 7u] = uintBitsToFloat(xw.w & 0xFFFF0000u); \
}
// Code e of the group sits at bit 3e of the six plane words; four codes straddle a word boundary.
#define GREEDY_A(e) ((((e) * 3u) % 32u <= 29u) \
  ? ((pw[((e) * 3u) / 32u] >> (((e) * 3u) % 32u)) & 7u) \
  : (((pw[((e) * 3u) / 32u] >> (((e) * 3u) % 32u)) | \
      (pw[((e) * 3u) / 32u + 1u] << ((32u - ((e) * 3u) % 32u) & 31u))) & 7u))
#define GREEDY_TERM(e) h = fma(float(GREEDY_A(e)), xr[(e)], h);
#define GREEDY_TERM4(e) GREEDY_TERM(e) GREEDY_TERM((e) + 1u) \
  GREEDY_TERM((e) + 2u) GREEDY_TERM((e) + 3u)
#define GREEDY_TERM16(e) GREEDY_TERM4(e) GREEDY_TERM4((e) + 4u) \
  GREEDY_TERM4((e) + 8u) GREEDY_TERM4((e) + 12u)

// One exact column: the full GEMV's Q4_ROW, subgroupAdd, and bf16 store.
float greedy_exact(uint column, uint lane_in_slot) {
  uint n = params.matrix_n;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_row = params.lhs_offset;
  precise float accumulator = 0.0;
  uint w_base = params.rhs_offset + column * words_per_row;
  uint scale_base = params.aux_offset + column * groups_per_row;
  uint bias_base = params.aux_size + column * groups_per_row;
  Q4_ROW(input_w, scales, biases)
  return LOAD_VALUE(STORE_VALUE(subgroupAdd(accumulator)));
}

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint column_slot = lane / LANES;
  uint lane_in_slot = lane % LANES;
  uint n = params.matrix_n;
  uint groups_per_row = params.matrix_k / 64u;
  uint x_row = params.lhs_offset;
  uint stage = params.operation;
  if (stage == 0u) {
    uvec4 xw = input_x.values[(x_row + lane * 8u) / 8u];
    float xs[8];
    xs[0] = uintBitsToFloat((xw.x & 0xFFFFu) << 16u);
    xs[1] = uintBitsToFloat(xw.x & 0xFFFF0000u);
    xs[2] = uintBitsToFloat((xw.y & 0xFFFFu) << 16u);
    xs[3] = uintBitsToFloat(xw.y & 0xFFFF0000u);
    xs[4] = uintBitsToFloat((xw.z & 0xFFFFu) << 16u);
    xs[5] = uintBitsToFloat(xw.z & 0xFFFF0000u);
    xs[6] = uintBitsToFloat((xw.w & 0xFFFFu) << 16u);
    xs[7] = uintBitsToFloat(xw.w & 0xFFFF0000u);
    precise float sum = 0.0;
    precise float l1 = 0.0;
    uint refuse = 0u;
    for (uint i = 0u; i < 8u; ++i) {
      sum += xs[i];
      l1 += abs(xs[i]);
      refuse |= (abs(xs[i]) <= 1048576.0) ? 0u : 1u;
