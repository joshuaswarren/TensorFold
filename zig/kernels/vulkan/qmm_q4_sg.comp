// Push routing: operation bits, reduce_size group size, flags bit 0 layout, scale and bias bindings, per-batch stride.

// Constant-shift select chain from scatter.comp: runtime word and lane, constant shift per lane.
uint byte_at(uint word, uint lane) {
  return (lane == 0u)
      ? (word & 0xFFu)
      : (lane == 1u)
      ? ((word >> 8u) & 0xFFu)
      : (lane == 2u)
      ? ((word >> 16u) & 0xFFu)
      : ((word >> 24u) & 0xFFu);
}

#ifdef FP_MODE
float fp8_decode(uint bits) {
  float magnitude = unpackHalf2x16((bits & 127u) << 7u).x * 256.0;
  return ((bits & 128u) != 0u) ? -magnitude : magnitude;
}

float e8m0_decode(uint bits) {
  return uintBitsToFloat(bits == 0u ? 0x400000u : bits << 23u);
}

// FP4 E2M1 decodes through the fp16 subnormal bit trick, the missing 2^14 landing in the scale factor.
float fp4_decode(uint code) {
  float magnitude = unpackHalf2x16((code & 7u) << 9u).x * 16384.0;
  return ((code & 8u) != 0u) ? -magnitude : magnitude;
}
#else
// Affine byte-pack decode uses the upstream extract table of constant shifts.
uint q3_at(uint e, uint c0, uint c1, uint c2) {
  if (e == 0u) return c0 & 0x7u;
  if (e == 1u) return (c0 >> 3) & 0x7u;
  if (e == 2u) return ((c0 >> 6) & 0x3u) + ((c1 & 0x1u) << 2);
  if (e == 3u) return (c1 >> 1) & 0x7u;
  if (e == 4u) return (c1 >> 4) & 0x7u;
  if (e == 5u) return ((c1 >> 7) & 0x1u) + ((c2 & 0x3u) << 1);
  if (e == 6u) return (c2 >> 2) & 0x7u;
  return (c2 >> 5) & 0x7u;
}

uint q5_at(uint e, uint c0, uint c1, uint c2, uint c3, uint c4) {
  if (e == 0u) return c0 & 0x1fu;
  if (e == 1u) return ((c0 >> 5) & 0x7u) + ((c1 & 0x3u) << 3);
  if (e == 2u) return (c1 >> 2) & 0x1fu;
  if (e == 3u) return ((c1 >> 7) & 0x1u) + ((c2 & 0xfu) << 1);
  if (e == 4u) return ((c2 >> 4) & 0xfu) + ((c3 & 0x1u) << 4);
  if (e == 5u) return (c3 >> 1) & 0x1fu;
  if (e == 6u) return ((c3 >> 6) & 0x3u) + ((c4 & 0x7u) << 2);
  return (c4 >> 3) & 0x1fu;
}

uint q6_at(uint e, uint c0, uint c1, uint c2) {
  if (e == 0u) return c0 & 0x3fu;
  if (e == 1u) return ((c0 >> 6) & 0x3u) + ((c1 & 0xfu) << 2);
  if (e == 2u) return ((c1 >> 4) & 0xfu) + ((c2 & 0x3u) << 4);
  return (c2 >> 2) & 0x3fu;
}
#endif

// Shipped builds are 4-bit group 64; QGROUP=32 changes the group, QBITS=8 reads two weight words per eight values.
#ifndef QBITS
#define QBITS 4
#endif
#ifndef QGROUP
#define QGROUP 64
#endif
#if QBITS != 4 || QGROUP != 64
#if !defined(QMM_VEC_Q4_WORD) || ROWS_PER_SLOT < 2 || \
    defined(QMM_VEC_MULTI) || defined(QMM_VEC_BATCH) || \
    defined(QMM_VEC_TOKENS) || defined(QMM_VEC_GREEDY)
#error "QBITS/QGROUP builds cover the multi-row word kernel only"
#endif
#if (QBITS != 4 && QBITS != 8) || (QGROUP != 64 && QGROUP != 32)
#error "QBITS must be 4 or 8 and QGROUP 64 or 32"
#endif
#endif
#ifdef QMM_VEC_Q4_WORD
// One x quad against the low 16 bits: every product is exact, so each fma rounds exactly the sum native qdot rounds.
#ifdef USE_FP16
// Native load_vector adds four halves in half; unpackFloat2x16 is a bitcast; Q4_WORD supplies one uvec4 load.
#define Q4_QUAD_LOAD(lo, hi) \
  f16vec2 h01 = unpackFloat2x16(lo); \
  f16vec2 h23 = unpackFloat2x16(hi); \
  float16_t h0 = h01.x; \
  float16_t h1 = h01.y; \
  float16_t h2 = h23.x; \
  float16_t h3 = h23.y; \
  input_sum += float(((h0 + h1) + h2) + h3); \
  float x0 = float(h0); \
  float x1 = float(h1); \
  float x2 = float(h2); \
  float x3 = float(h3);
#elif defined(USE_BF16)
// Packed-x bf16 quads widen exactly and keep the float order; one uvec4 load replaces eight 2-byte scalar loads.
#define Q4_QUAD_LOAD(lo, hi) \
  float x0 = uintBitsToFloat(((lo) & 0xFFFFu) << 16u); \
  float x1 = uintBitsToFloat((lo) & 0xFFFF0000u); \
  float x2 = uintBitsToFloat(((hi) & 0xFFFFu) << 16u); \
  float x3 = uintBitsToFloat((hi) & 0xFFFF0000u); \
  input_sum += ((x0 + x1) + x2) + x3;
#else
// f32 has nothing to round, so the uncaptured quad sum keeps the float chain.
#define Q4_QUAD_LOAD(base, unused) \
  float x0 = LOAD_VALUE(input_x.values[base]); \
  float x1 = LOAD_VALUE(input_x.values[(base) + 1u]); \
  float x2 = LOAD_VALUE(input_x.values[(base) + 2u]); \
  float x3 = LOAD_VALUE(input_x.values[(base) + 3u]); \
  input_sum += ((x0 + x1) + x2) + x3;
#endif
// Exact float(n) for a nibble: insert it into the exponent word of 2^23 and subtract 2^23, exact in f32.
#define Q4_NIB(p, shift) \
  (uintBitsToFloat((((p) >> (shift)) & 0xfu) | 0x4B000000u) - 8388608.0)
#define Q4_QUAD(packed, a, b) { \
  Q4_QUAD_LOAD(a, b) \
  uint p = (packed); \
  dot += fma(x3, Q4_NIB(p, 12u), \
      fma(x2, Q4_NIB(p, 8u), \
          fma(x1, Q4_NIB(p, 4u), \
              x0 * Q4_NIB(p, 0u)))); \
}
// One packed weight word and its eight x values.
#if defined(USE_FP16) || defined(USE_BF16)
#define Q4_WORD(word, x_base) { \
  uint word_value = (word); \
  uvec4 x_words = OUTGATE_XWORDS(x_base); \
  Q4_QUAD(word_value, x_words.x, x_words.y) \
  Q4_QUAD(word_value >> 16u, x_words.z, x_words.w) \
}
#else
#define Q4_WORD(word, x_base) { \
  uint word_value = (word); \
  uint quad_base = (x_base); \
  Q4_QUAD(word_value, quad_base, 0u) \
  Q4_QUAD(word_value >> 16u, quad_base + 4u, 0u) \
}
#endif
// The block epilogue adds fma(scale, dot, sum * bias); S and B let the multi-weight variant instantiate per weight.
#define Q4_BLOCK_FINISH(w, S, B) { \
  uint group = (w) / 8u; \
  float scale = LOAD_VALUE(S.values[scale_base + group]); \
  float bias = LOAD_VALUE(B.values[bias_base + group]); \
  precise float bias_term = input_sum * bias; \
  accumulator += fma(scale, dot, bias_term); \
}
// One column, native qmv order: half quad sums, float dot, fma(scale, dot, sum * bias); precise ops pin the order.
#define Q4_ROW(W, S, B) { \
  if (params.matrix_k % 512u == 0u && n % 8u == 0u) { \
    for (uint w = lane_in_slot * 2u; w < words_per_row; \
         w += LANES * 2u) { \
      precise float dot = 0.0; \
      precise float input_sum = 0.0; \
      Q4_WORD(W.values[w_base + w], x_row + w * 8u) \
      Q4_WORD(W.values[w_base + w + 1u], x_row + w * 8u + 8u) \
      Q4_BLOCK_FINISH(w, S, B) \
    } \
  } else { \
    for (uint w = lane_in_slot; w < words_per_row; w += LANES) { \
      precise float dot = 0.0; \
      precise float input_sum = 0.0; \
      Q4_WORD(W.values[w_base + w], x_row + w * 8u) \
      Q4_BLOCK_FINISH(w, S, B) \
    } \
  } \
}
#if ROWS_PER_SLOT > 1
// Multi-row Q4_ROW: rows clamp to n - 1 so loads stay in bounds; per row the chain matches Q4_ROW exactly, x shared.
#define Q4_QUAD_ROWS(P_EXPR, a, b) { \
  Q4_QUAD_LOAD(a, b) \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    uint p = (P_EXPR); \
    dot[r] += fma(x3, Q4_NIB(p, 12u), \
        fma(x2, Q4_NIB(p, 8u), \
            fma(x1, Q4_NIB(p, 4u), \
                x0 * Q4_NIB(p, 0u)))); \
  } \
}
#if QGROUP == 32
#define Q4_ROWS_GROUP(w) ((w) / 4u)
#else
#define Q4_ROWS_GROUP(w) ((w) / 8u)
#endif
#if QBITS == 8
// Exact float(b) for a byte b in [0, 255]; same trick as Q4_NIB.
#define Q8_BYTE(p, shift) \
  (uintBitsToFloat((((p) >> (shift)) & 0xffu) | 0x4B000000u) - 8388608.0)
#endif
#define Q4_ROWS_FINISH(w, S, B) { \
  uint group = Q4_ROWS_GROUP(w); \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    float scale = \
        LOAD_VALUE(S.values[s_base + row_base[r] * groups_per_row + group]); \
    float bias = \
        LOAD_VALUE(B.values[b_base + row_base[r] * groups_per_row + group]); \
    precise float bias_term = input_sum * bias; \
    acc[r] += fma(scale, dot[r], bias_term); \
  } \
}
#if QBITS == 8
// 8-bit twin of Q4_ROWS in native qmv_fast order: one eight-value step per lane, float load sum, one fma ladder.
#ifdef USE_FP16
#define Q8_X8(xw) \
  float x0 = float(unpackFloat2x16((xw).x).x); \
  float x1 = float(unpackFloat2x16((xw).x).y); \
  float x2 = float(unpackFloat2x16((xw).y).x); \
  float x3 = float(unpackFloat2x16((xw).y).y); \
  float x4 = float(unpackFloat2x16((xw).z).x); \
  float x5 = float(unpackFloat2x16((xw).z).y); \
  float x6 = float(unpackFloat2x16((xw).w).x); \
  float x7 = float(unpackFloat2x16((xw).w).y);
#else
#define Q8_X8(xw) \
  float x0 = uintBitsToFloat(((xw).x & 0xFFFFu) << 16u); \
  float x1 = uintBitsToFloat((xw).x & 0xFFFF0000u); \
  float x2 = uintBitsToFloat(((xw).y & 0xFFFFu) << 16u); \
  float x3 = uintBitsToFloat((xw).y & 0xFFFF0000u); \
  float x4 = uintBitsToFloat(((xw).z & 0xFFFFu) << 16u); \
  float x5 = uintBitsToFloat((xw).z & 0xFFFF0000u); \
  float x6 = uintBitsToFloat(((xw).w & 0xFFFFu) << 16u); \
  float x7 = uintBitsToFloat((xw).w & 0xFFFF0000u);
#endif
#define Q4_ROWS(W, S, B) { \
  uint row_base[ROWS_PER_SLOT]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    row_base[r] = min(column + r, n - 1u); \
  } \
  for (uint w = lane_in_slot; w < words_per_row; w += LANES) { \
    precise float dot[ROWS_PER_SLOT]; \
    precise float input_sum = 0.0; \
    uvec4 xa = OUTGATE_XWORDS(x_row + w * 8u); \
    Q8_X8(xa) \
    input_sum += x0; \
    input_sum += x1; \
    input_sum += x2; \
    input_sum += x3; \
    input_sum += x4; \
    input_sum += x5; \
    input_sum += x6; \
    input_sum += x7; \
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
      uint lo = W.values[w_base + row_base[r] * row_words + 2u * w]; \
      uint hi = W.values[w_base + row_base[r] * row_words + 2u * w + 1u]; \
      dot[r] = fma(x7, Q8_BYTE(hi, 24u), fma(x6, Q8_BYTE(hi, 16u), \
          fma(x5, Q8_BYTE(hi, 8u), fma(x4, Q8_BYTE(hi, 0u), \
          fma(x3, Q8_BYTE(lo, 24u), fma(x2, Q8_BYTE(lo, 16u), \
          fma(x1, Q8_BYTE(lo, 8u), x0 * Q8_BYTE(lo, 0u)))))))); \
    } \
    Q4_ROWS_FINISH(w, S, B) \
  } \
}
#else
#define Q4_ROWS(W, S, B) { \
  uint row_base[ROWS_PER_SLOT]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    row_base[r] = min(column + r, n - 1u); \
  } \
  if (params.matrix_k % 512u == 0u && n % 8u == 0u) { \
    for (uint w = lane_in_slot * 2u; w < words_per_row; \
         w += LANES * 2u) { \
      precise float dot[ROWS_PER_SLOT]; \
      precise float input_sum = 0.0; \
      uint wa[ROWS_PER_SLOT]; \
      uint wb[ROWS_PER_SLOT]; \
      for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
        dot[r] = 0.0; \
        wa[r] = W.values[w_base + row_base[r] * words_per_row + w]; \
        wb[r] = W.values[w_base + row_base[r] * words_per_row + w + 1u]; \
      } \
      uvec4 xa = OUTGATE_XWORDS(x_row + w * 8u); \
      uvec4 xb = OUTGATE_XWORDS(x_row + w * 8u + 8u); \
      Q4_QUAD_ROWS(wa[r], xa.x, xa.y) \
