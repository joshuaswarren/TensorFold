    // Stage 4 walks the survivor list, stage 6 (flagged only) every row; each subgroup owns one column at a time.
    bool full = stage == 6u;
    if (full && state.values[STATE_FULL] == 0u) {
      return;
    }
    uint count = full ? n : state.values[STATE_COUNT];
    for (uint k = gl_WorkGroupID.x * COLUMNS_PER_GROUP + column_slot;
         k < count;
         k += gl_NumWorkGroups.x * COLUMNS_PER_GROUP) {
      float value = greedy_exact(full ? k : survivors.values[k], lane_in_slot);
      if (lane_in_slot == 0u) {
        row_values.values[k] = value;
      }
