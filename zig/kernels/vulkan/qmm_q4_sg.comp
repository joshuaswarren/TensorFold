      float scale = LOAD_VALUE(scales.values[params.aux_offset + param]);
      float bias = LOAD_VALUE(biases.values[params.aux_size + param]);
      precise float h = 0.0;
      GREEDY_TERM16(0u) GREEDY_TERM16(16u) GREEDY_TERM16(32u)
      GREEDY_TERM16(48u)
      precise float center = 2.0 * scale * h + (0.5 * scale + bias) * group_sum;
      precise float radius = abs(scale) * group_l1;
      precise float mass = (16.0 * abs(scale) + abs(bias)) * group_l1;
      float c = subgroupAdd(center);
      float ub = c + 0.5 * subgroupAdd(radius) +
          subgroupAdd(mass) * (1.0 / 4096.0) + 9.094947e-13;
      if (lane_in_slot == 0u) {
        bounds.values[row] = ub;
      }
      nan_seen |= (isnan(ub) || isnan(c)) ? 1u : 0u;
      if (ub > ub_max) {
        ub_max = ub;
      }
      if (c > best_center) {
        best_center = c;
        best_row = row;
      }
    }
    if (lane_in_slot == 0u) {
      greedy_values[column_slot] = best_center;
      greedy_values[8u + column_slot] = ub_max;
      greedy_rows[column_slot] = best_row;
      greedy_rows[8u + column_slot] = nan_seen;
    }
    barrier();
    if (lane == 0u) {
      float center = NEG_INF;
      uint row = greedy_rows[0];
      float ubs = NEG_INF;
      uint nans = 0u;
      for (uint k = 0u; k < 8u; ++k) {
        if (greedy_values[k] > center) {
          center = greedy_values[k];
          row = greedy_rows[k];
        }
        ubs = greedy_values[8u + k] > ubs ? greedy_values[8u + k] : ubs;
        nans |= greedy_rows[8u + k];
      }
      // Candidates ride the survivor buffer; stage 3 overwrites them after stage 2 has read them.
      survivors.values[gl_WorkGroupID.x] = row;
      atomicMax(state.values[STATE_UB], order_key(ubs));
      if (nans != 0u) {
        atomicOr(state.values[STATE_FULL], 1u);
