// Multi-weight main: each workgroup range picks one weight so barriers stay uniform; the epilogue adds the stored sum.
#ifdef USE_FP16
#define ROUND_STORAGE(f) (unpackHalf2x16(packHalf2x16(vec2(f, 0.0))).x)
#elif defined(USE_BF16)
#define ROUND_STORAGE(f) LOAD_VALUE(bf16_store(f))
#else
#define ROUND_STORAGE(f) (f)
