// The prologue recomputes the product per workgroup with identical bits; workgroup 0 stores it for retained references.
layout(set = 0, binding = 25, std430) readonly buffer OutgateOut {
  uvec4 values[];
} outgate_out;
layout(set = 0, binding = 26, std430) readonly buffer OutgateGate {
  uvec4 values[];
} outgate_gate;
layout(set = 0, binding = 27, std430) writeonly buffer OutgateMul {
  uvec4 values[];
} outgate_mul;
uint16_t outgate_sig_lane(uint g_bits) {
  float g = uintBitsToFloat(g_bits << 16u);
  return bf16_store(1.0 / (1.0 + exp(-g)));
}
uint outgate_word(uint o, uint g) {
  float sig_lo = uintBitsToFloat(
      uint(outgate_sig_lane(g & 0xFFFFu)) << 16u);
  float sig_hi = uintBitsToFloat(
      uint(outgate_sig_lane(g >> 16u)) << 16u);
  float lo = uintBitsToFloat((o & 0xFFFFu) << 16u) * sig_lo;
  float hi = uintBitsToFloat((o & 0xFFFF0000u)) * sig_hi;
  return uint(bf16_store(lo)) | (uint(bf16_store(hi)) << 16u);
}
uvec4 outgate_quad(uint quad_index) {
  uvec4 o = outgate_out.values[quad_index];
  uvec4 g = outgate_gate.values[quad_index];
  uvec4 m = {outgate_word(o.x, g.x), outgate_word(o.y, g.y),
             outgate_word(o.z, g.z), outgate_word(o.w, g.w)};
  if (gl_WorkGroupID.x == 0u) {
    outgate_mul.values[quad_index] = m;
  }
  return m;
}
#define OUTGATE_XWORDS(x_base) outgate_quad((x_base) / 8u)
