// Multi-token forms put the token dimension inside the k walk; each row's chain matches single-token bit for bit.
#define Q4_QUAD_LOAD_T(a, b, isum) \
  float x0 = uintBitsToFloat(((a) & 0xFFFFu) << 16u); \
  float x1 = uintBitsToFloat((a) & 0xFFFF0000u); \
  float x2 = uintBitsToFloat(((b) & 0xFFFFu) << 16u); \
  float x3 = uintBitsToFloat((b) & 0xFFFF0000u); \
  isum += ((x0 + x1) + x2) + x3;
#define Q4_TOK_DOT(dst, p) \
  (dst) += fma(x3, Q4_NIB(p, 12u), \
      fma(x2, Q4_NIB(p, 8u), \
          fma(x1, Q4_NIB(p, 4u), \
              x0 * Q4_NIB(p, 0u))))
// One block serves all tokens: weights load once, x quads once per token; dot and input_sum run per column and token.
#define Q4_TOK_BLOCK(W, S, B, words_this_step) { \
  uint wa[ROWS_PER_SLOT]; \
  uint wb[ROWS_PER_SLOT]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    wa[r] = W.values[w_base + row_base[r] * words_per_row + w]; \
    if ((words_this_step) == 2u) { \
      wb[r] = W.values[w_base + row_base[r] * words_per_row + w + 1u]; \
    } \
  } \
  precise float dot_t[ROWS_PER_SLOT][M_TOKENS]; \
  precise float input_sum_t[ROWS_PER_SLOT][M_TOKENS]; \
  for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
    for (uint m = 0u; m < M_TOKENS; ++m) { \
      dot_t[r][m] = 0.0; \
      input_sum_t[r][m] = 0.0; \
    } \
  } \
  for (uint m = 0u; m < M_TOKENS; ++m) { \
    if (m >= token_count) { \
      continue; \
    } \
    uint x_row_m = params.lhs_offset + m * params.matrix_k; \
    uvec4 xa = input_x.values[(x_row_m + w * 8u) / 8u]; \
    uvec4 xb; \
    if ((words_this_step) == 2u) { \
      xb = input_x.values[(x_row_m + w * 8u + 8u) / 8u]; \
    } \
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
      { Q4_QUAD_LOAD_T(xa.x, xa.y, input_sum_t[r][m]) \
        uint p = wa[r]; Q4_TOK_DOT(dot_t[r][m], p); } \
      { Q4_QUAD_LOAD_T(xa.z, xa.w, input_sum_t[r][m]) \
        uint p = wa[r] >> 16u; Q4_TOK_DOT(dot_t[r][m], p); } \
      if ((words_this_step) == 2u) { \
        { Q4_QUAD_LOAD_T(xb.x, xb.y, input_sum_t[r][m]) \
          uint p = wb[r]; Q4_TOK_DOT(dot_t[r][m], p); } \
        { Q4_QUAD_LOAD_T(xb.z, xb.w, input_sum_t[r][m]) \
          uint p = wb[r] >> 16u; Q4_TOK_DOT(dot_t[r][m], p); } \
      } \
    } \
  } \
  uint group = w / 8u; \
  for (uint m = 0u; m < M_TOKENS; ++m) { \
    if (m >= token_count) { \
      continue; \
    } \
    for (uint r = 0u; r < uint(ROWS_PER_SLOT); ++r) { \
      float scale = \
          LOAD_VALUE(S.values[s_base + row_base[r] * groups_per_row + group]); \
      float bias = \
          LOAD_VALUE(B.values[b_base + row_base[r] * groups_per_row + group]); \
      precise float bias_term = input_sum_t[r][m] * bias; \
      acc_t[m][r] += fma(scale, dot_t[r][m], bias_term); \
    } \
  } \
}
