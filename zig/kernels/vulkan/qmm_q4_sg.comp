    if (lane == 0u) {
      state.values[STATE_LB] = 0u;
      state.values[STATE_UB] = 0u;
      state.values[STATE_COUNT] = 0u;
      state.values[STATE_FULL] =
          (greedy_flag != 0u || (params.flags & 1u) != 0u) ? 1u : 0u;
    }
    return;
  }
  if (stage == 1u) {
    float group_sum = uintBitsToFloat(state.values[lane_in_slot]);
    float group_l1 = uintBitsToFloat(state.values[32u + lane_in_slot]);
    float xr[64];
    uint xbase = (x_row + lane_in_slot * 64u) / 8u;
    GREEDY_X8(0u) GREEDY_X8(1u) GREEDY_X8(2u) GREEDY_X8(3u)
    GREEDY_X8(4u) GREEDY_X8(5u) GREEDY_X8(6u) GREEDY_X8(7u)
    uint plane_words = groups_per_row * 6u;
    float ub_max = NEG_INF;
    float best_center = NEG_INF;
    uint best_row = 0u;
    uint nan_seen = 0u;
    uint first = gl_WorkGroupID.x * (8u * GREEDY_ROWS_PER_SLOT) + column_slot;
    for (uint i = 0u; i < GREEDY_ROWS_PER_SLOT; ++i) {
      uint row = first + i * 8u;
      if (row >= n) {
        break;
      }
      uint p_base = params.rhs_size + row * plane_words + lane_in_slot * 6u;
      uint pw[7];
      for (uint k = 0u; k < 6u; ++k) {
        pw[k] = plane.values[p_base + k];
      }
      pw[6] = 0u;
