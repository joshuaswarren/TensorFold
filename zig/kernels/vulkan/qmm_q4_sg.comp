    return;
  }
  if (stage == 5u) {
    uint count = state.values[STATE_COUNT];
    if (lane == 0u) {
      greedy_flag = 0u;
    }
    float best = NEG_INF;
    uint best_row = 0xffffffffu;
    uint nan_seen = 0u;
    for (uint k = lane; k < count; k += 256u) {
      float v = row_values.values[k];
      uint r = survivors.values[k];
      nan_seen |= isnan(v) ? 1u : 0u;
      if (v > best || (v == best && r < best_row)) {
        best = v;
        best_row = r;
      }
    }
    greedy_values[lane] = best;
    greedy_rows[lane] = best_row;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (lane < stride) {
        float v = greedy_values[lane + stride];
        uint r = greedy_rows[lane + stride];
        if (v > greedy_values[lane] ||
            (v == greedy_values[lane] && r < greedy_rows[lane])) {
          greedy_values[lane] = v;
          greedy_rows[lane] = r;
        }
      }
      barrier();
    }
    float top = greedy_values[0];
    uint top_row = greedy_rows[0];
    float guard = 0.13 + abs(top) * (1.0 / 12800.0);
    uint risk = nan_seen;
    for (uint k = lane; k < count; k += 256u) {
      float v = row_values.values[k];
      risk |= (survivors.values[k] < top_row && v < top && top - v <= guard)
          ? 1u : 0u;
    }
    if (risk != 0u) {
      atomicOr(greedy_flag, 1u);
    }
    barrier();
    if (lane == 0u) {
      bool full = state.values[STATE_FULL] != 0u || greedy_flag != 0u ||
          top_row == 0xffffffffu;
      token.values[0] = top_row;
      stats.values[0] = count;
      stats.values[1] = full ? 1u : 0u;
      stats.values[2] = floatBitsToUint(top);
      state.values[STATE_FULL] = full ? 1u : 0u;
    }
    return;
  }
  // Stage 7, flagged only: LogSumExpBF16 over the stage-6 logits, then the bf16 subtract and ArgMaxBF16.
  if (state.values[STATE_FULL] == 0u) {
    return;
  }
  float local_max = NEG_INF;
  for (uint index = lane; index < n; index += 256u) {
    float next = row_values.values[index];
    if (isnan(next) || next > local_max) {
      local_max = next;
    }
  }
  greedy_values[lane] = local_max;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (lane < stride) {
      greedy_values[lane] =
          max(greedy_values[lane], greedy_values[lane + stride]);
    }
    barrier();
  }
  float row_max = greedy_values[0];
  barrier();
  float local_sum = 0.0;
  for (uint index = lane; index < n; index += 256u) {
    local_sum += exp(row_values.values[index] - row_max);
  }
  greedy_values[lane] = local_sum;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (lane < stride) {
      greedy_values[lane] += greedy_values[lane + stride];
    }
    barrier();
  }
  float row_sum = greedy_values[0];
  float value = isinf(row_max) ? row_max : row_max + log(row_sum);
  float lse = LOAD_VALUE(STORE_VALUE(value));
  barrier();
  float local_value = NEG_INF;
  uint local_index = 0u;
  for (uint index = lane; index < n; index += 256u) {
    float next = LOAD_VALUE(STORE_VALUE(row_values.values[index] - lse));
    if (next > local_value) {
      local_value = next;
      local_index = index;
    }
  }
  greedy_values[lane] = local_value;
  greedy_rows[lane] = local_index;
  barrier();
  for (uint stride = 128u; stride > 0u; stride >>= 1u) {
    if (lane < stride) {
      float mine = greedy_values[lane];
      float theirs = greedy_values[lane + stride];
      bool wins = theirs > mine;
      bool ties = theirs == mine &&
          greedy_rows[lane + stride] < greedy_rows[lane];
      if (wins || ties) {
        greedy_values[lane] = theirs;
        greedy_rows[lane] = greedy_rows[lane + stride];
      }
    }
    barrier();
  }
  if (lane == 0u) {
    token.values[0] = greedy_rows[0];
    stats.values[2] = floatBitsToUint(lse);
  }
}
