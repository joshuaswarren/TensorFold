#version 460

// Clean-room implementation of docs/spec/vulkan-qmm-q4.md section 2.
// 16-byte vectorized row-major 4-bit affine projection, BF16 in and out:
//   out[m, n] = sum_k x[m, k] * (float(q[n, k]) * scale[n, k/64] + bias[n, k/64])
// One thread per output element, grid-stride loop, float32 accumulation.
// Weight row n is K/32 uvec4 vectors; x row m is K/8 uvec4 vectors (8 bf16 each).
// Group g covers uvec4 weights 2g..2g+1 and uvec4 x rows 8g..8g+7.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec4 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

float bf16_widen(uint16_t h) {
  return uintBitsToFloat(uint(h) << 16u);
}

// IEEE-754 round-to-nearest-even narrowing, quieting NaN.
uint16_t bf16_narrow(float x) {
  uint u = floatBitsToUint(x);
  if ((u & 0x7fffffffu) > 0x7f800000u) {
    return uint16_t((u >> 16u) | 0x0040u);
  }
  uint lsb = (u >> 16u) & 1u;
  return uint16_t((u + 0x7fffu + lsb) >> 16u);
}

// Two bf16 lanes packed in one word: low lane first.
float bf16_low(uint pair) {
  return uintBitsToFloat(pair << 16u);
}
float bf16_high(uint pair) {
  return uintBitsToFloat(pair & 0xffff0000u);
}

void main() {
  uint groups_per_row = params.matrix_k / 64u;
  uint w_vecs_per_col = params.matrix_k / 32u;
  uint x_vecs_per_row = params.matrix_k / 8u;
  uint total = params.matrix_m * params.matrix_n;
  uint stride = gl_NumWorkGroups.x * 256u;

  for (uint index = gl_GlobalInvocationID.x; index < total;
       index += stride) {
    uint row = index / params.matrix_n;
    uint column = index - row * params.matrix_n;
    // Offsets are elements of the bound type; the host's 16-byte alignment
    // guarantee keeps them uvec4-aligned.
    uint w_base = params.rhs_offset / 4u + column * w_vecs_per_col;
    uint x_base = params.lhs_offset / 8u + row * x_vecs_per_row;
    uint param_base =
        params.aux_offset + column * groups_per_row;
    uint bias_base =
        params.aux_size + column * groups_per_row;
    float acc = 0.0;
    for (uint group = 0u; group < groups_per_row; ++group) {
      float scale = bf16_widen(scales.values[param_base + group]);
      float bias = bf16_widen(biases.values[bias_base + group]);
      // Two weight vectors a group; each word holds eight 4-bit codes.
      for (uint v = 0u; v < 2u; ++v) {
        uvec4 wv = input_w.values[w_base + group * 2u + v];
        for (uint word_i = 0u; word_i < 4u; ++word_i) {
          uint word = wv[word_i];
          // Four x vectors a weight word: two elements per x word lane.
          uvec4 xv = input_x
              .values[x_base + group * 8u + v * 4u + word_i];
          for (uint pair_i = 0u; pair_i < 4u; ++pair_i) {
            uint xp = xv[pair_i];
            uint q0 = (word >> (pair_i * 8u)) & 0xfu;
            uint q1 = (word >> (pair_i * 8u + 4u)) & 0xfu;
            acc += bf16_low(xp) * (float(q0) * scale + bias);
            acc += bf16_high(xp) * (float(q1) * scale + bias);
          }
        }
      }
    }
    output_data.values[params.output_offset + index] = bf16_narrow(acc);
  }
}
