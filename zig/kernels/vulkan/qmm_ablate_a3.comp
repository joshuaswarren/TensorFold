#version 460

// ABLATE A3 (private probe kernel): the FULL real arithmetic — compensated
// TwoSum, the frozen expression, the same 6-barrier tree — but every output
// reads the SAME first 64 packed words, the same 8 scale/bias pairs and the
// same x row (the column index masked to 0 and the pack index masked into
// 0..63), so all workgroups hit the same cache lines. Timing-only: it is the
// cache-resident latency/ALU test; its outputs are not per-output results and
// no correctness gate is claimed.

// Copyright © 2026 Joshua Warren and mlx-omarchy contributors; MIT License, full text in LICENSES/mlx-omarchy-MIT.txt.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint16_t values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float tree[64];
shared float tree_lo[64];

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint packs = params.matrix_k / 8u;
  uint total = params.matrix_m * params.matrix_n;

  for (uint index = gl_WorkGroupID.x; index < total; index += gl_NumWorkGroups.x) {
    uint row = index / params.matrix_n;
    uint column = index - row * params.matrix_n;
    // A3's only difference: every output reads column 0's first 64 packed
    // words and their 8 scale/bias pairs — one shared cache-resident window.
    uint column_eff = 0u;
    uint w_base = column_eff * words_per_row;
    uint x_base = row * params.matrix_k;
    bool contiguous = (params.flags & 1u) != 0u && (packs % 64u) == 0u;
    uint chunk = packs / 64u;
    uint first = contiguous ? lane * chunk : lane;
    uint step = contiguous ? 1u : 64u;
    uint last = contiguous ? first + chunk : packs;
    float partial = 0.0;
    float comp = 0.0;
    for (uint pack = first; pack < last; pack += step) {
      uint pack_eff = pack & 63u;
      float scale = bf16_load(scales.values[column_eff * groups_per_row + pack_eff / 8u]);
      float bias = bf16_load(biases.values[column_eff * groups_per_row + pack_eff / 8u]);
      uint word = input_w.values[w_base + pack_eff];
      uint k_base = pack_eff * 8u;
      for (uint e = 0u; e < 8u; ++e) {
        float q = float((word >> (e * 4u)) & 0xFu);
        precise float term = bf16_load(input_x.values[x_base + k_base + e]) *
            (scale * q + bias);
        precise float t = partial + term;
        if (abs(partial) >= abs(term)) {
          comp += (partial - t) + term;
        } else {
          comp += (term - t) + partial;
        }
        partial = t;
      }
    }
    tree[lane] = partial;
    tree_lo[lane] = comp;
    barrier();
    for (uint stride = 32u; stride >= 1u; stride >>= 1u) {
      if (lane < stride) {
        precise float a = tree[lane];
        precise float b2 = tree[lane + stride];
        precise float sum = a + b2;
        precise float bb = sum - a;
        precise float err = (a - (sum - bb)) + (b2 - bb);
        tree[lane] = sum;
        tree_lo[lane] = tree_lo[lane] + tree_lo[lane + stride] + err;
      }
      barrier();
    }
    if (lane == 0u) {
      float total_sum = (isnan(tree[0]) || isinf(tree[0])) ? tree[0] : tree[0] + tree_lo[0];
      output_data.values[index] = bf16_store(total_sum);
    }
    barrier();
  }
}
