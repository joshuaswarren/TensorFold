// Planted controls (TF_CTL_DOUBLE, TF_CTL_BF16, TF_CTL_SCRIBBLE, TF_CTL_TAIL) compiled from a copy of penalize.comp.
#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Logits {
  uint16_t values[];
} logits;
layout(set = 0, binding = 1, std430) readonly buffer Tok {
  uint toks[];
};
layout(set = 0, binding = 2, std430) readonly buffer Sub {
  float subs[];
};

layout(push_constant) uniform Params {
  uint count;
} params;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

// A bf16 round trip of an fp32 value (the TF_CTL_BF16 fault); the gate must catch this rounding.
float bf16_round(float value) {
  uint bits = floatBitsToUint(value);
  return uintBitsToFloat((bits + 0x7fffu + ((bits >> 16) & 1u)) & 0xffff0000u);
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.count) return;
#ifdef TF_CTL_TAIL
  if (i + 1u >= params.count) return; // the last entry never applies
#endif
  float x = uintBitsToFloat(uint(logits.values[toks[i]]) << 16u);
#if defined(TF_CTL_DOUBLE)
  float d = (x - subs[i]) - subs[i];
#elif defined(TF_CTL_BF16)
  float d = bf16_round(x) - bf16_round(subs[i]);
#else
  float d = x - subs[i];
#endif
  logits.values[toks[i]] = bf16_store(d);
#ifdef TF_CTL_SCRIBBLE
  logits.values[toks[i] ^ 1u] = bf16_store(d); // a word beside the named token
#endif
}
