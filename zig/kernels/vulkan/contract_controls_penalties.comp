// The penalize kernel's planted controls for the Vulkan kernel contract: four
// faults compiled from this COPY of penalize.comp's structure, so the
// production zig/kernels/vulkan/penalize.comp itself stays untouched (the
// same rule as contract_controls_greedy.comp). Each control must go red at
// exactly its registered gate:
//   -DTF_CTL_DOUBLE=1   applies each entry twice (the amount subtracted
//                       twice): the penalized word is wrong, the shapes gate's
//                       exact check refuses it.
//   -DTF_CTL_BF16=1     rounds the logit and the amount to bf16 BEFORE the
//                       subtract: a different rounding chain than the CUDA
//                       formula (exact widening, one fp32 subtract), the
//                       shapes gate's exact check refuses it.
//   -DTF_CTL_SCRIBBLE=1 also writes the word beside the named token (the
//                       entries are staged over distinct even tokens, so the
//                       neighbor is never an entry): the repeat gate's
//                       untouched-word and guard check refuses it.
//   -DTF_CTL_TAIL=1     drops the last entry: its token stays unpenalized,
//                       the shapes gate's exact check refuses it.
// Bindings, push block, workgroup size and grid are penalize.comp's: the
// control rides the same dispatch model, only the arithmetic differs.
#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Logits {
  uint16_t values[];
} logits;
layout(set = 0, binding = 1, std430) readonly buffer Tok {
  uint toks[];
};
layout(set = 0, binding = 2, std430) readonly buffer Sub {
  float subs[];
};

layout(push_constant) uniform Params {
  uint count;
} params;

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

// A bf16 round trip of an fp32 value (the fault TF_CTL_BF16 plants): not the
// CUDA formula's exact widening — this rounding is what the gate must catch.
float bf16_round(float value) {
  uint bits = floatBitsToUint(value);
  return uintBitsToFloat((bits + 0x7fffu + ((bits >> 16) & 1u)) & 0xffff0000u);
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.count) return;
#ifdef TF_CTL_TAIL
  if (i + 1u >= params.count) return; // the last entry never applies
#endif
  float x = uintBitsToFloat(uint(logits.values[toks[i]]) << 16u);
#if defined(TF_CTL_DOUBLE)
  float d = (x - subs[i]) - subs[i];
#elif defined(TF_CTL_BF16)
  float d = bf16_round(x) - bf16_round(subs[i]);
#else
  float d = x - subs[i];
#endif
  logits.values[toks[i]] = bf16_store(d);
#ifdef TF_CTL_SCRIBBLE
  logits.values[toks[i] ^ 1u] = bf16_store(d); // a word beside the named token
#endif
}
