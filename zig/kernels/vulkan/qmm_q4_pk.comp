#version 460

// Q4 projection, one 64-lane workgroup per output (row, column), parallel over K. Lane l walks the row's
// packed words l, l+64, ... in ascending order. The 8 elements of one packed word are summed with plain
// left-associated f32 adds (psum += x * (scale * q + bias), precise: the order is as written, no fused
// multiply-add); ONE Neumaier fold per pack carries the pack sum into the lane's (hi, lo) pair; a fixed
// shared-memory tree of TwoSum merges folds the 64 lanes (strides 32, 16, 8, 4, 2, 1, a barrier between
// levels, no subgroup ops, no atomics); lane 0 adds low to high once and stores with the repo's bf16
// RNE. The grid-stride over outputs keeps every barrier in uniform control flow.
//
// Not bit-identical to the previous kernel (which compensated every element): the in-pack sum is plain,
// so each pack sum carries up to 7 ordinary f32 roundings (about 1e-7 relative) that the per-element
// chain caught. The contract states this kernel's depth as 8 * ceil(k / 512) + 17 roundings (49 at K 2048).

// Copyright (c) 2026 Joshua Warren and mlx-omarchy contributors; MIT License, full text in LICENSES/mlx-omarchy-MIT.txt.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint16_t values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float tree[64];
shared float tree_lo[64];

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint packs = params.matrix_k / 8u;
  uint total = params.matrix_m * params.matrix_n;

  for (uint index = gl_WorkGroupID.x; index < total; index += gl_NumWorkGroups.x) {
    uint row = index / params.matrix_n;
    uint column = index - row * params.matrix_n;
    uint w_base = column * words_per_row;
    uint x_base = row * params.matrix_k;

    bool contiguous = (params.flags & 1u) != 0u && (packs % 64u) == 0u;
    uint chunk = packs / 64u;
    uint first = contiguous ? lane * chunk : lane;
    uint step = contiguous ? 1u : 64u;
    uint last = contiguous ? first + chunk : packs;
    precise float partial = 0.0;
    precise float comp = 0.0;
    for (uint pack = first; pack < last; pack += step) {
      float scale = bf16_load(scales.values[column * groups_per_row + pack / 8u]);
      float bias = bf16_load(biases.values[column * groups_per_row + pack / 8u]);
      uint word = input_w.values[w_base + pack];
      uint k_base = pack * 8u;
      precise float psum = 0.0;
      for (uint e = 0u; e < 8u; ++e) {
        float q = float((word >> (e * 4u)) & 0xFu);
        // plain left-associated in-pack adds: the re-association C2 exists for
        psum += bf16_load(input_x.values[x_base + k_base + e]) *
            (scale * q + bias);
      }
      // ONE TwoSum fold per pack into the lane's (hi, lo)
      precise float t = partial + psum;
      if (abs(partial) >= abs(psum)) {
        comp += (partial - t) + psum;
      } else {
        comp += (psum - t) + partial;
      }
      partial = t;
    }
    tree[lane] = partial;
    tree_lo[lane] = comp;
    barrier();
    for (uint stride = 32u; stride >= 1u; stride >>= 1u) {
      if (lane < stride) {
        precise float a = tree[lane];
        precise float b2 = tree[lane + stride];
        precise float sum = a + b2;
        precise float bb = sum - a;
        precise float err = (a - (sum - bb)) + (b2 - bb);
        tree[lane] = sum;
        tree_lo[lane] = tree_lo[lane] + tree_lo[lane + stride] + err;
      }
      barrier();
    }
    if (lane == 0u) {
      float total_sum = (isnan(tree[0]) || isinf(tree[0])) ? tree[0] : tree[0] + tree_lo[0];
      output_data.values[index] = bf16_store(total_sum);
    }
    barrier();
  }
}
