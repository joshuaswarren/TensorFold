#version 460

// CANDIDATE C1 (private probe kernel): the real qmm_q4_pk with one-deep
// software-pipelined loads — before a pack's 32 arithmetic operations run, the
// next pack's word, scale, bias and all 8 widened x elements are already
// issued, so the memory latency overlaps the arithmetic. The per-output
// arithmetic is UNCHANGED: same lane pack order (l, l+64, ...), same element
// order, the same scale*float(q)+bias term and compensated TwoSum per element,
// the same fixed 6-level tree, class fix and bf16 RNE store. Every operand
// value is bit-identical (float() of a nibble and the bf16 widen are exact),
// so every output must equal qmm_q4_pk.comp's bit for bit; the probe proves
// that before timing. Never a shipped kernel.

// Copyright © 2026 Joshua Warren and mlx-omarchy contributors; MIT License, full text in LICENSES/mlx-omarchy-MIT.txt.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint16_t values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float tree[64];
shared float tree_lo[64];

float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint words_per_row = params.matrix_k / 8u;
  uint groups_per_row = params.matrix_k / 64u;
  uint packs = params.matrix_k / 8u;
  uint total = params.matrix_m * params.matrix_n;

  for (uint index = gl_WorkGroupID.x; index < total; index += gl_NumWorkGroups.x) {
    uint row = index / params.matrix_n;
    uint column = index - row * params.matrix_n;
    uint w_base = column * words_per_row;
    uint x_base = row * params.matrix_k;
    bool contiguous = (params.flags & 1u) != 0u && (packs % 64u) == 0u;
    uint chunk = packs / 64u;
    uint first = contiguous ? lane * chunk : lane;
    uint step = contiguous ? 1u : 64u;
    uint last = contiguous ? first + chunk : packs;
    float partial = 0.0;
    float comp = 0.0;
    // the pipeline's current pack, loaded before the loop (lanes with no packs stay at zeros)
    uint pack = first;
    float scale = 0.0;
    float bias = 0.0;
    uint word = 0u;
    uint16_t xb[8];
    float q[8];
    for (uint e = 0u; e < 8u; ++e) {
      xb[e] = uint16_t(0u);
      q[e] = 0.0;
    }
    if (pack < last) {
      scale = bf16_load(scales.values[column * groups_per_row + pack / 8u]);
      bias = bf16_load(biases.values[column * groups_per_row + pack / 8u]);
      word = input_w.values[w_base + pack];
      uint k_base = pack * 8u;
      for (uint e = 0u; e < 8u; ++e) {
        xb[e] = input_x.values[x_base + k_base + e];
        q[e] = float((word >> (e * 4u)) & 0xFu); // exact, so hoisting changes no value
      }
    }
    while (pack < last) {
      // issue the next pack's loads now; this pack's arithmetic overlaps them
      uint next = pack + step;
      bool has_next = next < last;
      float n_scale = scale;
      float n_bias = bias;
      uint n_word = word;
      uint16_t n_xb[8];
      float n_q[8];
      if (has_next) {
        n_scale = bf16_load(scales.values[column * groups_per_row + next / 8u]);
        n_bias = bf16_load(biases.values[column * groups_per_row + next / 8u]);
        n_word = input_w.values[w_base + next];
        uint n_k_base = next * 8u;
        for (uint e = 0u; e < 8u; ++e) {
          n_xb[e] = input_x.values[x_base + n_k_base + e];
          n_q[e] = float((n_word >> (e * 4u)) & 0xFu);
        }
      }
      // the frozen per-element arithmetic, unchanged in value and order
      for (uint e = 0u; e < 8u; ++e) {
        precise float term = bf16_load(xb[e]) *
            (scale * q[e] + bias);
        precise float t = partial + term;
        if (abs(partial) >= abs(term)) {
          comp += (partial - t) + term;
        } else {
          comp += (term - t) + partial;
        }
        partial = t;
      }
      pack = next;
      scale = n_scale;
      bias = n_bias;
      word = n_word;
      for (uint e = 0u; e < 8u; ++e) {
        xb[e] = n_xb[e];
        q[e] = n_q[e];
      }
    }
    tree[lane] = partial;
    tree_lo[lane] = comp;
    barrier();
    for (uint stride = 32u; stride >= 1u; stride >>= 1u) {
      if (lane < stride) {
        precise float a = tree[lane];
        precise float b2 = tree[lane + stride];
        precise float sum = a + b2;
        precise float bb = sum - a;
        precise float err = (a - (sum - bb)) + (b2 - bb);
        tree[lane] = sum;
        tree_lo[lane] = tree_lo[lane] + tree_lo[lane + stride] + err;
      }
      barrier();
    }
    if (lane == 0u) {
      float total_sum = (isnan(tree[0]) || isinf(tree[0])) ? tree[0] : tree[0] + tree_lo[0];
      output_data.values[index] = bf16_store(total_sum);
    }
    barrier();
  }
}
