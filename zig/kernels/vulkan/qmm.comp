#version 460

// Clean-room implementation of docs/spec/vulkan-qmm-q4.md section 1.
// Scalar row-major affine-quantized projection:
//   out[m, n] = sum_k x[m, k] * (float(q[n, k]) * scale[n, k/G] + bias[n, k/G])
// accumulated in float32, one thread per output element, grid-stride loop.
//
// Row-major weight stream: w[n][k] is a little-endian bit field of `bits` codes
// packed low-first into uint words (bits in {2,4,8}) or byte runs (bits in
// {3,5,6}). scales/biases hold one STORAGE_TYPE value per `reduce_size` group.
// flags bit 0 selects the non-transposed layout: w[k][n], scale[k][n/G].

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

// ACT_F32: activations and output are float32; scales and biases stay bf16.
#ifdef ACT_F32
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  float values[];
} input_x;
#define ACT_READ(i) (input_x.values[i])
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  float values[];
} output_data;
#else
layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint16_t values[];
} input_x;
#define ACT_READ(i) bf16_widen(input_x.values[i])
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;
#endif

layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

float bf16_widen(uint16_t h) {
  return uintBitsToFloat(uint(h) << 16u);
}

// IEEE-754 round-to-nearest-even narrowing, quieting NaN.
uint16_t bf16_narrow(float x) {
  uint u = floatBitsToUint(x);
  if ((u & 0x7fffffffu) > 0x7f800000u) {
    return uint16_t((u >> 16u) | 0x0040u);
  }
  uint lsb = (u >> 16u) & 1u;
  return uint16_t((u + 0x7fffu + lsb) >> 16u);
}

// Byte lane of a 32-bit word, constant shifts only.
uint byte_lane(uint word, uint lane) {
  return (word >> (lane * 8u)) & 0xffu;
}

// Read byte `idx` of the weight stream starting at word `word_base`.
uint w_byte(uint word_base, uint idx) {
  return byte_lane(input_w.values[word_base + (idx >> 2u)], idx & 3u);
}

void main() {
  uint bits = params.operation;
  uint group_size = params.reduce_size;
  bool non_transposed = (params.flags & 1u) != 0u;
  bool byte_packed = (bits == 3u || bits == 5u || bits == 6u);
  // codes per pack and bytes per pack from the bit stream length.
  uint pack_elems = byte_packed ? (bits == 6u ? 4u : 8u) : (32u / bits);
  uint pack_bytes = byte_packed ? (bits == 5u ? 5u : 3u) : 1u;
  uint code_mask = (1u << bits) - 1u;
  uint packs_in_group = group_size / pack_elems;
  uint words_per_row = params.matrix_k * bits / 32u;
  uint groups_per_row = params.matrix_k / group_size;
  uint batch = params.shape[0];
  uint w_batch_words = params.shape[1];
  uint param_batch = params.shape[2];
  uint matrix = params.matrix_m * params.matrix_n;
  uint x_rows_per_batch = params.matrix_m * params.matrix_k;
  uint total = batch * matrix;
  uint stride = gl_NumWorkGroups.x * 256u;

  for (uint index = gl_GlobalInvocationID.x; index < total;
       index += stride) {
    uint b = index / matrix;
    uint within = index - b * matrix;
    uint row = within / params.matrix_n;
    uint column = within - row * params.matrix_n;
    uint x_base =
        params.lhs_offset + b * x_rows_per_batch + row * params.matrix_k;
    float acc = 0.0;

    if (non_transposed) {
      // w[k][n]: one fixed lane of the row's packs walks k. The column's
      // code sits in the same pack lane for every k row.
      uint row_bytes = params.matrix_n * bits / 8u;
      uint row_words = params.matrix_n * bits / 32u;
      uint group_pack_bytes = packs_in_group * pack_bytes;
      uint lane = column % pack_elems;
      uint bit_off = lane * bits;
      uint col_byte =
          (column / group_size) * group_pack_bytes +
          ((column % group_size) / pack_elems) * pack_bytes;
      uint col_word = column / pack_elems;
      uint scale_col = column / group_size;
      uint param_step = params.matrix_n / group_size;
      uint param_top =
          params.aux_offset + b * param_batch + scale_col;
      uint w_row0 = params.rhs_offset + b * w_batch_words;
      for (uint k = 0u; k < params.matrix_k; ++k) {
        float scale = bf16_widen(
            scales.values[param_top + k * param_step]);
        float bias = bf16_widen(biases
            .values[params.aux_size + b * param_batch + scale_col +
                k * param_step]);
        uint q;
        if (byte_packed) {
          // The code's field spans at most two adjacent pack bytes; the
          // second byte is only read when the field crosses the boundary,
          // so the stream's last byte is never over-read.
          uint byte_i = k * row_bytes + col_byte + (bit_off >> 3u);
          uint shift = bit_off & 7u;
          uint pair = w_byte(w_row0, byte_i) |
              (((shift + bits) > 8u ? w_byte(w_row0, byte_i + 1u) : 0u)
               << 8u);
          q = (pair >> shift) & code_mask;
        } else {
          uint word = input_w.values[params.rhs_offset +
              b * w_batch_words + k * row_words + col_word];
          q = (word >> bit_off) & code_mask;
        }
        acc += ACT_READ(x_base + k) * (scale * float(q) + bias);
      }
    } else {
      // w[n][k]: one row of packs per column; group the k walk by reduce_size.
      uint w_row = params.rhs_offset + b * w_batch_words +
          column * words_per_row;
      uint scale_row = params.aux_offset + b * param_batch +
          column * groups_per_row;
      uint bias_row = params.aux_size + b * param_batch +
          column * groups_per_row;
      uint group = 0u;
      for (uint k = 0u; k < params.matrix_k; k += group_size) {
        float scale = bf16_widen(scales.values[scale_row + group]);
        float bias = bf16_widen(biases.values[bias_row + group]);
        ++group;
        for (uint pack = 0u; pack < packs_in_group; ++pack) {
          uint k_pack = k + pack * pack_elems;
          if (byte_packed) {
            uint pack_byte =
                (group - 1u) * packs_in_group * pack_bytes +
                pack * pack_bytes;
            for (uint e = 0u; e < pack_elems; ++e) {
              uint bit_off = e * bits;
              uint byte_i = pack_byte + (bit_off >> 3u);
              uint shift = bit_off & 7u;
              uint pair =
                  w_byte(w_row, byte_i) |
                  (((shift + bits) > 8u
                        ? w_byte(w_row, byte_i + 1u)
                        : 0u)
                   << 8u);
              uint q = (pair >> shift) & code_mask;
              acc += ACT_READ(x_base + k_pack + e) *
                  (scale * float(q) + bias);
            }
          } else {
            uint word = input_w.values[w_row + k / pack_elems + pack];
            for (uint e = 0u; e < pack_elems; ++e) {
              uint q = (word >> (e * bits)) & code_mask;
              acc += ACT_READ(x_base + k_pack + e) *
                  (scale * float(q) + bias);
            }
          }
        }
      }
    }
#ifdef ACT_F32
    output_data.values[params.output_offset + index] = acc;
#else
    output_data.values[params.output_offset + index] = bf16_narrow(acc);
#endif
  }
}
