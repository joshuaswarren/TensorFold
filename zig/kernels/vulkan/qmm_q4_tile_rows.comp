#version 460

// Clean-room implementation of docs/spec/vulkan-qmm-q4.md section 4.
// 4-row x 2-column tiled prompt 4-bit affine projection, BF16 only:
//   out[m, n] = sum_k x[m, k] * (float(q[n, k]) * scale[n, k/64] + bias[n, k/64])
// Each thread computes up to four consecutive rows against two columns of one
// 32-column tile: the weight vectors are fetched once per column and reused
// across the rows, and each activation vector serves both columns. float32
// accumulation, single round-to-nearest-even bf16 store.
//
// Thread grid (host: threads = row_blocks * col_tiles * 16):
//   rb = tid / (col_tiles * 16), tile = (tid % (col_tiles * 16)) / 16,
//   sub = tid % 16, m0 = rb * 4, c0 = tile * 32 + sub, c1 = c0 + 16.
// Tiled weight layout identical to qmm_q4_tile.comp: column c has
// tile = c / 32, lane = c % 32; weight uvec4 j at
// ((tile * vectors + j) * 32 + lane), group scale/bias bf16 at
// ((tile * groups + g) * 32 + lane).

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uvec4 values[];
} input_x;
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uvec4 values[];
} input_w;
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

float bf16_widen(uint16_t h) {
  return uintBitsToFloat(uint(h) << 16u);
}

// IEEE-754 round-to-nearest-even narrowing, quieting NaN.
uint16_t bf16_narrow(float x) {
  uint u = floatBitsToUint(x);
  if ((u & 0x7fffffffu) > 0x7f800000u) {
    return uint16_t((u >> 16u) | 0x0040u);
  }
  uint lsb = (u >> 16u) & 1u;
  return uint16_t((u + 0x7fffu + lsb) >> 16u);
}

// Two bf16 lanes packed in one word: low lane first.
float bf16_low(uint pair) {
  return uintBitsToFloat(pair << 16u);
}
float bf16_high(uint pair) {
  return uintBitsToFloat(pair & 0xffff0000u);
}

void main() {
  uint vectors = params.matrix_k / 32u;
  uint groups = params.matrix_k / 64u;
  uint m = params.matrix_m;
  uint n = params.matrix_n;
  uint col_tiles = (n + 31u) / 32u;
  uint row_blocks = (m + 3u) / 4u;
  uint tile_threads = col_tiles * 16u;
  uint threads = row_blocks * tile_threads;
  uint tid = gl_GlobalInvocationID.x;
  if (tid >= threads) {
    return;
  }
  uint rb = tid / tile_threads;
  uint rem = tid - rb * tile_threads;
  uint tile = rem / 16u;
  uint sub = rem - tile * 16u;
  uint m0 = rb * 4u;
  uint c0 = tile * 32u + sub;
  uint c1 = c0 + 16u;
  bool have_c0 = c0 < n;
  bool have_c1 = c1 < n;
  uint rows = min(4u, m - m0);

  uint x_vecs_per_row = params.matrix_k / 8u;
  uint w0_base =
      params.rhs_offset / 4u + (tile * vectors) * 32u + sub;
  uint w1_base = w0_base + 16u;
  uint scale0_base = params.aux_offset + (tile * groups) * 32u + sub;
  uint bias0_base = params.aux_size + (tile * groups) * 32u + sub;
  uint x0_row = params.lhs_offset / 8u + m0 * x_vecs_per_row;

  float acc_c0[4];
  float acc_c1[4];
  for (uint r = 0u; r < 4u; ++r) {
    acc_c0[r] = 0.0;
    acc_c1[r] = 0.0;
  }

  for (uint group = 0u; group < groups; ++group) {
    float scale0 = bf16_widen(scales.values[scale0_base + group * 32u]);
    float bias0 = bf16_widen(biases.values[bias0_base + group * 32u]);
    float scale1 =
        bf16_widen(scales.values[scale0_base + group * 32u + 16u]);
    float bias1 =
        bf16_widen(biases.values[bias0_base + group * 32u + 16u]);
    for (uint v = 0u; v < 2u; ++v) {
      uvec4 wv0 = input_w.values[w0_base + (group * 2u + v) * 32u];
      uvec4 wv1 = input_w.values[w1_base + (group * 2u + v) * 32u];
      for (uint word_i = 0u; word_i < 4u; ++word_i) {
        uint word0 = wv0[word_i];
        uint word1 = wv1[word_i];
        uint xv_index = group * 8u + v * 4u + word_i;
        for (uint r = 0u; r < rows; ++r) {
          // The activation vector serves both columns of this word.
          uvec4 xv = input_x
              .values[x0_row + r * x_vecs_per_row + xv_index];
          for (uint pair_i = 0u; pair_i < 4u; ++pair_i) {
            uint xp = xv[pair_i];
            float x_lo = bf16_low(xp);
            float x_hi = bf16_high(xp);
            uint shift = pair_i * 8u;
            acc_c0[r] += x_lo *
                (float((word0 >> shift) & 0xfu) * scale0 + bias0);
            acc_c0[r] += x_hi *
                (float((word0 >> (shift + 4u)) & 0xfu) * scale0 +
                    bias0);
            acc_c1[r] += x_lo *
                (float((word1 >> shift) & 0xfu) * scale1 + bias1);
            acc_c1[r] += x_hi *
                (float((word1 >> (shift + 4u)) & 0xfu) * scale1 +
                    bias1);
          }
        }
      }
    }
  }

  // Padded tail tiles and rows past M never write.
  for (uint r = 0u; r < rows; ++r) {
    uint out_row = params.output_offset + (m0 + r) * n;
    if (have_c0) {
      output_data.values[out_row + c0] = bf16_narrow(acc_c0[r]);
    }
    if (have_c1) {
      output_data.values[out_row + c1] = bf16_narrow(acc_c1[r]);
    }
  }
}
