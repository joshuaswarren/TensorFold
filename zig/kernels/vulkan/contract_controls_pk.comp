#version 460

// The qmm_q4_pk kernel with one planted fault per variant, for the Vulkan kernel contract's
// controls: each control is this copy compiled with one define, and the shipped qmm_q4_pk.comp
// stays untouched. Every variant reads the same bindings and push constants and evaluates the
// same per-element expression as the kernel it copies; the fault is only the one the define
// names, and the runner pushes the same flags (2: strided lanes, compensated sums) so each
// fault lands on the path the real kernel takes.
//
//   TF_CTL_PK_DROP_TAIL   the last lane never walks the row's final pack: a tail the sums miss
//   TF_CTL_PK_FP16        the lane sums accumulate in fp16
//   TF_CTL_PK_SKIP_LEVEL  the lane tree starts one level down, so the upper half never folds in
//   TF_CTL_PK_WRITE_W     lane 0 writes a fixed word just past the weights data after the walk
//   TF_CTL_PK_WRITE_B     lane 0 writes a fixed element just past the biases data after the walk
//
// The two writes land past the data, where no workgroup reads, so the outputs stay correct and
// only the gate 2 read-back of the inputs can see them; the fixture's buffers carry guard tails
// past the data, as the qmm_bf16 fixture's do for its own input-write controls.

// Copyright © 2026 Joshua Warren and mlx-omarchy contributors; MIT License, full text in LICENSES/mlx-omarchy-MIT.txt.

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#ifdef TF_CTL_PK_FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InputX {
  uint16_t values[];
} input_x;
#ifdef TF_CTL_PK_WRITE_W
layout(set = 0, binding = 1, std430) buffer InputW {
  uint values[];
} input_w;
#else
layout(set = 0, binding = 1, std430) readonly buffer InputW {
  uint values[];
} input_w;
#endif
layout(set = 0, binding = 2, std430) readonly buffer Scales {
  uint16_t values[];
} scales;
#ifdef TF_CTL_PK_WRITE_B
layout(set = 0, binding = 3, std430) buffer Biases {
  uint16_t values[];
} biases;
#else
layout(set = 0, binding = 3, std430) readonly buffer Biases {
  uint16_t values[];
} biases;
#endif
layout(set = 0, binding = 4, std430) writeonly buffer Output {
  uint16_t values[];
} output_data;

// The stage 1 120-byte ComputeParams; only matrix_m/matrix_n/matrix_k are read.
layout(push_constant) uniform Params {
  uint count;
  uint operation;
  uint lhs_size;
  uint rhs_size;
  uint reduce_size;
  uint output_size;
  uint lhs_offset;
  uint rhs_offset;
  uint output_offset;
  uint aux_size;
  uint aux_offset;
  uint matrix_m;
  uint matrix_n;
  uint matrix_k;
  uint flags;
  float alpha;
  float beta;
  uint dims;
  uint shape[4];
  uint in_strides[4];
  uint out_strides[4];
} params;

shared float tree[64];
shared float tree_lo[64]; // compensated variants only

// Widened bf16: exact f32, the qmm.comp LOAD_VALUE read.
float bf16_load(uint16_t bits) {
  return uintBitsToFloat(uint(bits) << 16u);
}

// The repo's bf16_store RNE, shared verbatim with qmm.comp (NaN keeps its quiet class).
uint16_t bf16_store(float value) {
  uint bits = floatBitsToUint(value);
  if (isnan(value)) {
    return uint16_t((bits >> 16) | 0x40u);
  }
  return uint16_t((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

void main() {
  uint lane = gl_LocalInvocationID.x;
  uint words_per_row = params.matrix_k / 8u;   // 16 packed nibbles a word
  uint groups_per_row = params.matrix_k / 64u; // group 64: 8 words a group
  uint packs = params.matrix_k / 8u;           // one word packs 8 q4 elements
  uint total = params.matrix_m * params.matrix_n;

  for (uint index = gl_WorkGroupID.x; index < total; index += gl_NumWorkGroups.x) {
    uint row = index / params.matrix_n;
    uint column = index - row * params.matrix_n;
    uint w_base = column * words_per_row;
    uint x_base = row * params.matrix_k;
    bool contiguous = (params.flags & 1u) != 0u && (packs % 64u) == 0u;
    bool compensated = (params.flags & 2u) != 0u;
    uint chunk = packs / 64u;
    uint first = contiguous ? lane * chunk : lane;
    uint step = contiguous ? 1u : 64u;
    uint last = contiguous ? first + chunk : packs;
    float partial = 0.0;
    float comp = 0.0;
    for (uint pack = first; pack < last; pack += step) {
#ifdef TF_CTL_PK_DROP_TAIL
      // the fault: the last lane skips the row's final pack
      if (lane == 63u && pack + 1u == packs) continue;
#endif
      float scale = bf16_load(scales.values[column * groups_per_row + pack / 8u]);
      float bias = bf16_load(biases.values[column * groups_per_row + pack / 8u]);
      uint word = input_w.values[w_base + pack];
      uint k_base = pack * 8u;
      for (uint e = 0u; e < 8u; ++e) {
        float q = float((word >> (e * 4u)) & 0xFu);
        precise float term = bf16_load(input_x.values[x_base + k_base + e]) *
            (scale * q + bias);
#ifdef TF_CTL_PK_FP16
        // the fault: the running sum keeps fp16 precision
        partial = float(float16_t(partial) + float16_t(term));
#else
        if (compensated) {
          precise float t = partial + term;
          if (abs(partial) >= abs(term)) {
            comp += (partial - t) + term;
          } else {
            comp += (term - t) + partial;
          }
          partial = t;
        } else {
          partial += term;
        }
#endif
      }
    }
    tree[lane] = partial;
    tree_lo[lane] = comp;
    barrier();
    uint stride0 = 32u;
#ifdef TF_CTL_PK_SKIP_LEVEL
    // the fault: the tree's top level never runs, so lanes 32..63 never fold in
    stride0 = 16u;
#endif
    for (uint stride = stride0; stride >= 1u; stride >>= 1u) {
      if (lane < stride) {
        if (compensated) {
          precise float a = tree[lane];
          precise float b2 = tree[lane + stride];
          precise float sum = a + b2;
          precise float bb = sum - a;
          precise float err = (a - (sum - bb)) + (b2 - bb);
          tree[lane] = sum;
          tree_lo[lane] = tree_lo[lane] + tree_lo[lane + stride] + err;
        } else {
          tree[lane] += tree[lane + stride];
        }
      }
      barrier();
    }
    if (lane == 0u) {
      // the shipped kernel's class fix, once per output at the high+low combine: a non-finite
      // high keeps its class, a finite high always has a finite chain beneath it, so the else
      // operand is exactly the frozen expression
      float total_sum = tree[0];
      if (compensated) {
        total_sum = (isnan(tree[0]) || isinf(tree[0])) ? tree[0] : tree[0] + tree_lo[0];
      }
      output_data.values[index] = bf16_store(total_sum);
    }
    barrier(); // orders this iteration's reads before the next grid-stride iteration's writes
  }

#ifdef TF_CTL_PK_WRITE_W
  if (lane == 0u) input_w.values[params.matrix_n * words_per_row] = 0xdeadbeefu;
#endif
#ifdef TF_CTL_PK_WRITE_B
  if (lane == 0u) biases.values[params.matrix_n * groups_per_row] = uint16_t(0x3f80u);
#endif
}
